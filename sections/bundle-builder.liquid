<section class="bundle-builder">

<div class="bundle-container">


<h2>
{{ section.settings.title }}
</h2>


<p>
{{ section.settings.subtitle }}
</p>



<div class="bundle-products">


{% for block in section.blocks %}


<div class="bundle-item">


<h3>
{{ block.settings.label }}
</h3>


{% assign product = all_products[block.settings.product] %}



{% if product %}


<div class="bundle-card">


<img
src="{{ product.featured_image | image_url: width:400 }}"
alt="{{ product.title }}"
>


<h4>
{{ product.title }}
</h4>


<span>
{{ product.price | money }}
</span>



<button
class="bundle-add"
data-variant="{{ product.selected_or_first_available_variant.id }}"
>

Add

</button>


</div>


{% endif %}



</div>


{% endfor %}



</div>



<button class="bundle-cart">

ADD COMPLETE SET

</button>


</div>


</section>






<style>


.bundle-builder{

padding:50px 20px;

text-align:center;

}


.bundle-products{

display:flex;

gap:20px;

justify-content:center;

flex-wrap:wrap;

}



.bundle-card{

width:220px;

}


.bundle-card img{

width:100%;

aspect-ratio:1;

object-fit:cover;

}



.bundle-add{

padding:10px 20px;

border:1px solid #000;

background:white;

cursor:pointer;

}



.bundle-cart{

margin-top:30px;

padding:15px 40px;

background:black;

color:white;

border:none;

cursor:pointer;

}



</style>







<script>


document.addEventListener(
'DOMContentLoaded',
()=>{


let buttons =
document.querySelectorAll('.bundle-add');


let products=[];



buttons.forEach(btn=>{


btn.addEventListener(
'click',
()=>{


let id =
btn.dataset.variant;


products.push(id);


btn.innerHTML="Added";


});


});





document.querySelector(
'.bundle-cart'
)?.addEventListener(
'click',
()=>{


fetch('/cart/add.js',{

method:'POST',

headers:{

'Content-Type':'application/json'

},

body:JSON.stringify({

items:

products.map(id=>({

id:id,

quantity:1

}))

})


})
.then(()=>{

window.location.href="/cart";

});


});



});


</script>








{% schema %}

{

"name":"Bundle Builder",


"settings":[


{

"type":"text",

"id":"title",

"label":"Title",

"default":"BUILD YOUR BEACH SET"

},


{

"type":"text",

"id":"subtitle",

"label":"Subtitle",

"default":"Choose your favorite combination"

}


],



"blocks":[


{

"type":"product",

"name":"Bundle Product",

"settings":[


{

"type":"text",

"id":"label",

"label":"Label",

"default":"Choose Item"

},


{

"type":"product",

"id":"product",

"label":"Product"

}


]

}


],


"presets":[


{

"name":"Bundle Builder"

}


]


}

{% endschema %}
